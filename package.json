{
  "name": "claude-web-ui",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "claude-web-ui": "bin/claude-web-ui"
  },
  "scripts": {
    "start": "tsx server/index.ts",
    "start:mock": "tsx server/index.ts --mock",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts --mock",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "vite build",
    "test": "vitest run",
    "prepare": "test ! -x node_modules/.bin/vite || node_modules/.bin/vite build"
  },
  "files": [
    "bin/",
    "server/",
    "src/",
    "scripts/",
    "start.sh",
    "vite.config.ts",
    "tsconfig.json",
    "dist/"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "express": "^4.21.0",
    "katex": "^0.16.45",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tsx": "^4.19.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^9.0.0",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
